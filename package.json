    "@tiptap/starter-kit": "^3.34.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lucide-react": "^1.76.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
